rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return signedIn() && request.auth.token.email == 'simplemente_anibal@hotmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganizerOrAdmin() {
      return signedIn() && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          userDoc().role == 'admin' ||
          userDoc().role == 'organizador' ||
          ('roles' in userDoc() && ('admin' in userDoc().roles || 'organizador' in userDoc().roles))
        ))
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.auth.uid == userId || isOrganizerOrAdmin());
      allow update, delete: if isOrganizerOrAdmin() || request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /qrCatalog/{qrId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizerOrAdmin();
    }

    match /limitations/{limitId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizerOrAdmin();
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizerOrAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizerOrAdmin();
    }
  }
}
